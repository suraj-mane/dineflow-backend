{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types":                    ["jest", "node"],
    "noUnusedLocals":           false,
    "noUnusedParameters":       false,
    "allowImportingTsExtensions": false,
    "noEmit":                   true,
    "module":                   "CommonJS",
    "moduleResolution":         "node"
  },
  "include": ["src", "tests"]
}